# Copy to .env and adjust as needed. Read by podman-compose.yml (and by
# scripts/build-and-run.sh, which also uses SEED_USER_EMAIL/PASSWORD to seed
# a demo user before bringing the stack up).

# Secret used to HMAC-sign session cookies (backend service). Any long
# random string works for local dev; generate one with `openssl rand -hex 32`.
SESSION_SECRET="replace-with-a-long-random-string"

# Demo user created by `db/prisma/seed.ts` — used to log in once the stack
# is running.
SEED_USER_EMAIL="demo@example.com"
SEED_USER_PASSWORD="demo-password"
