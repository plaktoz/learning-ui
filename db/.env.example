# Copy to .env and adjust as needed.
# When running prisma/tsx commands directly from this directory (host, not
# a container), Postgres is reached via localhost. Inside podman-compose,
# the backend service instead uses `db:5432` — see the root .env.example.

DATABASE_URL="postgresql://noteapp:noteapp@localhost:5432/noteapp?schema=public"
SEED_USER_EMAIL="demo@example.com"
SEED_USER_PASSWORD="demo-password"
