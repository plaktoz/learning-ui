# Copy to .env.local and adjust as needed.
# When running `next dev`/`next start` directly on the host, Postgres is
# reached via localhost. Inside podman-compose, this service instead uses
# `db:5432` — see the root .env.example.

DATABASE_URL="postgresql://noteapp:noteapp@localhost:5432/noteapp?schema=public"

# Secret used to HMAC-sign session cookies. Any long random string works for
# local dev; generate one with `openssl rand -hex 32`.
SESSION_SECRET="replace-with-a-long-random-string"

# Origin the browser's frontend runs on — used for CORS response headers.
FRONTEND_ORIGIN="http://localhost:3000"
