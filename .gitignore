# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (unrooted: applies inside frontend/, backend/, db/ too)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# prisma generated client (regenerated via `npm run db:generate` in db/)
backend/generated/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/settings.local.json
