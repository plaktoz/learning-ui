# Copy to .env.local and adjust as needed.

# Backend origin the *browser* talks to (login form, sign-out button, and
# every ApiRepository call) — must be reachable from wherever the user's
# browser runs, hence the NEXT_PUBLIC_ prefix (inlined into client bundles
# at build time). On the host or in podman-compose alike, the backend
# publishes port 4000 to localhost, so this stays localhost:4000 either way.
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"

# Backend origin *this server* talks to, for the server-to-server fetch in
# src/lib/auth/current-user.ts. Same as above when running `next dev` on
# the host. Inside podman-compose, override to the Compose service name
# (http://backend:4000) — see the root .env.example — since the frontend
# container can't reach the backend via localhost.
BACKEND_INTERNAL_URL="http://localhost:4000"
